# Copy to .env.modelarts and fill every required value. Never commit the real file.
MODELARTS_AUTHORIZATION=replace-with-a-new-token
MODELARTS_ENDPOINT=https://your-modelarts-gateway.example.com/v2/PROJECT_ID/training-jobs
MODELARTS_REGION=cn-southwest-2
MODELARTS_WORKSPACE_ID=replace-me

# Runtime image must already contain Python, Torch/torch-npu, CANN and the
# dependencies declared by Auto-Mixture-Tool. The remote command installs the
# repository itself with --no-deps.
MODELARTS_IMAGE_URL=registry.example.com/auto-mixture-runtime:latest
MODELARTS_IMAGE_REPO_ID=replace-me

# OBS directory containing this repository.
MODELARTS_CODE_OBS_URL=/bucket/path/Auto-Mixture-Tool/

# Inputs mounted into the paths used by examples/configs/modelarts_pipeline.yaml.
MODELARTS_DATA_OBS_URL=/bucket/path/STEM_sample_100B_only_json/
MODELARTS_NANOCHAT_REPO_OBS_URL=/bucket/path/nanochat-npu/
MODELARTS_NANOCHAT_MODEL_OBS_URL=/bucket/path/nanochat-model-dir/
MODELARTS_OUTPUT_OBS_URL=/bucket/path/auto-mixture-results/

MODELARTS_FLAVOR_ID=modelarts.pool.visual.8xlarge
MODELARTS_NODE_COUNT=1
MODELARTS_POOL_ID=replace-me
MODELARTS_RESOURCE_POLICY=regular

# Optional SFS Turbo mount. Leave both empty to omit volumes from the request.
MODELARTS_NFS_SERVER_PATH=
MODELARTS_NFS_LOCAL_PATH=/mnt/sfsturbo
